# ============================================================
# CONFIGURACION BANCO GUAYAQUIL - SRI Scraper
# Copiar este archivo como .env y completar los valores reales
# ============================================================

# ---- Autenticacion interna (SQL Server) ----
# Activar bypass temporal hasta conectar la base real
AUTH_BYPASS_MODE=true
# Exigir centro de costo autorizado (TRIBU/COE ANALITICA Y DATA) ademas del login
VERIFICAR_AREA=false

# Autenticacion integrada de Windows (Trusted_Connection) - no requiere usuario/password
DB_HOST=GYEINTNEGDB01
DB_PORT=4433
DB_NAME=PROCESOS_BI

# ---- Configuracion de la aplicacion ----
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TITLE=SRI Scraper - Banco Guayaquil
APP_SECRET_KEY=change_this_to_a_random_secret_string

# ---- Playwright ----
# Directorio para perfil persistente de navegador (NO borrar entre ejecuciones)
BROWSER_PROFILE_DIR=./browser_profile
# Si el proyecto vive en un disco compartido y varias personas corren esta MISMA
# app (mismo .env) cada una desde su propia PC, BROWSER_PROFILE_DIR debe apuntar
# a una ruta LOCAL de cada maquina, nunca al disco compartido: Chrome/Edge no
# soportan un perfil persistente compartido por red (se bloquea con uso
# concurrente y arriesga corromper las bases internas del perfil vía SMB).
# Usar %LOCALAPPDATA% resuelve esto sin configurar nada por persona -- cada
# Windows lo expande a la carpeta local de su propio usuario automaticamente:
# BROWSER_PROFILE_DIR=%LOCALAPPDATA%\SRI-Scraper\browser_profile
#
# Headless=false por defecto para minimizar deteccion por reCAPTCHA
# Cambiar a true solo si se tiene Xvfb configurado en servidor sin GUI
BROWSER_HEADLESS=false

# ---- Descargas ----
# A diferencia de BROWSER_PROFILE_DIR, esta SI puede (y conviene) apuntar a un
# disco compartido cuando varias personas usan la app: los archivos ya
# descargados por cualquiera nunca se vuelven a bajar, sin importar quien
# corrio la consulta originalmente.
# DOWNLOADS_BASE_DIR=\\servidor\ruta\compartida\downloads
DOWNLOADS_BASE_DIR=./downloads

# ---- Log level: DEBUG, INFO, WARNING, ERROR ----
LOG_LEVEL=INFO
